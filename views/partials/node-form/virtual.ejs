<%
// Virtual node panes: vt-sources (which nodes are merged and how traffic is
// spread) and vt-probe (observatory + client-side latency test).
const v = node?.virtual || {};
const selectMode = v.selectMode || 'manual';
const strategy = v.strategy || 'leastLoad';
const obs = v.observatory || {};
const sourceIds = (v.sources || []).map(s => String(s._id || s));
const sourceGroupId = v.sourceGroup ? String(v.sourceGroup._id || v.sourceGroup) : '';
const fallbackToFirst = v.fallbackToFirst !== false;
const tolerance = Number.isFinite(v.tolerance) ? v.tolerance : 50;
const idleTimeout = v.idleTimeout || '';
const interruptExistConnections = v.interruptExistConnections !== false;
const cands = candidateNodes || [];
%>

<div class="nf-pane" data-pane="vt-sources" data-types="virtual" id="virtualSection">
    <div class="nf-pane__head">
        <h3>
            <%= t('nodes.paneSources') %>
            <a class="docs-hint-link" href="https://xtls.github.io/en/config/routing.html" target="_blank" rel="noopener noreferrer" title="Xray docs">ⓘ</a>
        </h3>
        <p><%= t('nodes.paneSourcesHint') %></p>
    </div>

    <div class="nf-standalone-field">
        <div class="nf-standalone-label"><%= t('nodes.virtualSelectMode') %></div>
        <div class="nf-seg" id="virtualSelectModeSeg">
            <label>
                <input type="radio" name="virtual.selectMode" value="manual"
                       <%= selectMode === 'manual' ? 'checked' : '' %>
                       onchange="virtualOnSelectModeChange('manual')">
                <span><i class="ti ti-list-check"></i> <%= t('nodes.virtualSelectModeManual') %></span>
            </label>
            <label>
                <input type="radio" name="virtual.selectMode" value="group"
                       <%= selectMode === 'group' ? 'checked' : '' %>
                       onchange="virtualOnSelectModeChange('group')">
                <span><i class="ti ti-users-group"></i> <%= t('nodes.virtualSelectModeGroup') %></span>
            </label>
        </div>
    </div>

    <div class="form-group" id="virtualManualGroup" style="<%= selectMode === 'manual' ? '' : 'display:none' %>">
        <label><%= t('nodes.virtualSources') %></label>
        <small><%= t('nodes.virtualSourcesHint') %></small>
        <% if (cands.length === 0) { %>
            <div class="nf-info" style="margin-top:8px;">
                <i class="ti ti-info-circle"></i>
                <div><strong><%= t('nodes.virtualNoCandidates') %></strong></div>
            </div>
        <% } %>
        <div class="nf-picks" style="margin-top:8px;max-height:280px;overflow-y:auto;">
            <% cands.forEach(c => {
                const checked = sourceIds.includes(String(c._id));
            %>
                <label class="nf-pick">
                    <input type="checkbox" name="virtual.sources[]" value="<%= c._id %>" <%= checked ? 'checked' : '' %>>
                    <span class="nf-pick__text">
                        <span class="nf-pick__name"><%= `${c.flag || ''} ${c.name}`.trim() %></span>
                        <span class="nf-pick__meta"><%= c.type %><%= c.active === false ? ` · ${t('common.inactive')}` : '' %></span>
                    </span>
                </label>
            <% }); %>
        </div>
    </div>

    <div class="form-group" id="virtualGroupGroup" style="<%= selectMode === 'group' ? '' : 'display:none' %>;max-width:360px;">
        <label for="virtualSourceGroup"><%= t('nodes.virtualSourceGroup') %></label>
        <small><%= t('nodes.virtualSourceGroupHint') %></small>
        <select id="virtualSourceGroup" name="virtual.sourceGroup">
            <option value=""><%= t('nodes.virtualSourceGroupPlaceholder') %></option>
            <% (groups || []).forEach(g => { %>
                <option value="<%= g._id %>" <%= sourceGroupId === String(g._id) ? 'selected' : '' %>><%= g.name %></option>
            <% }); %>
        </select>
    </div>

    <div class="nf-group">
        <div class="nf-group__title"><%= t('nodes.virtualStrategy') %></div>
        <small class="nf-section__hint"><%= t('nodes.virtualStrategyHint') %></small>
        <div class="nf-choices" id="virtualStrategyChoices">
            <% [
                { id: 'random',     icon: 'ti-arrows-shuffle', key: 'Random' },
                { id: 'roundRobin', icon: 'ti-rotate',         key: 'RoundRobin' },
                { id: 'leastPing',  icon: 'ti-bolt',           key: 'LeastPing' },
                { id: 'leastLoad',  icon: 'ti-chart-line',     key: 'LeastLoad' },
            ].forEach(item => { %>
                <label class="nf-choice">
                    <%# The value lives in the hidden virtual.strategy input below, so
                        these radios are UI-only and carry no name. %>
                    <input type="radio" data-strategy="<%= item.id %>" <%= strategy === item.id ? 'checked' : '' %>
                           onchange="virtualSelectStrategy('<%= item.id %>')">
                    <span class="nf-choice__text">
                        <span class="nf-choice__name"><i class="ti <%= item.icon %>"></i> <%= t(`nodes.virtualStrategy${item.key}`) %></span>
                        <span class="nf-choice__hint"><%= t(`nodes.virtualStrategy${item.key}Desc`) %></span>
                    </span>
                </label>
            <% }); %>
        </div>
        <input type="hidden" name="virtual.strategy" id="virtualStrategy" value="<%= strategy %>">
    </div>

    <div class="form-group">
        <label class="nf-tag">
            <input type="checkbox" name="virtual.fallbackToFirst" <%= fallbackToFirst ? 'checked' : '' %>>
            <span><%= t('nodes.virtualFallbackToFirst') %></span>
        </label>
        <small style="display:block;margin-top:6px;"><%= t('nodes.virtualFallbackToFirstHint') %></small>
    </div>
</div>

<div class="nf-pane" data-pane="vt-probe" data-types="virtual">
    <div class="nf-pane__head">
        <h3><%= t('nodes.paneProbe') %></h3>
        <p><%= t('nodes.paneProbeHint') %></p>
    </div>

    <%# Observatory only matters for the two latency-aware strategies. %>
    <div class="nf-group" id="virtualObservatorySection" style="<%= ['leastPing','leastLoad'].includes(strategy) ? '' : 'display:none' %>">
        <div class="nf-group__title"><i class="ti ti-radar"></i> <%= t('nodes.virtualObservatory') %></div>
        <small class="nf-section__hint"><%= t('nodes.virtualObservatoryHint') %></small>

        <div class="form-row">
            <div class="form-group">
                <label for="virtualObsDestination"><%= t('nodes.virtualObsDestination') %></label>
                <input type="text" id="virtualObsDestination" name="virtual.observatory.destination"
                       value="<%= obs.destination || 'http://www.gstatic.com/generate_204' %>"
                       placeholder="http://www.gstatic.com/generate_204">
                <small><%= t('nodes.virtualObsDestinationHint') %></small>
            </div>
            <div class="form-group">
                <label for="virtualObsConnectivity"><%= t('nodes.virtualObsConnectivity') %></label>
                <input type="text" id="virtualObsConnectivity" name="virtual.observatory.connectivity"
                       value="<%= obs.connectivity || '' %>"
                       placeholder="<%= t('nodes.virtualObsConnectivityPlaceholder') %>">
                <small><%= t('nodes.virtualObsConnectivityHint') %></small>
            </div>
        </div>

        <div class="form-row-3">
            <div class="form-group">
                <label for="virtualObsInterval"><%= t('nodes.virtualObsInterval') %></label>
                <input type="text" id="virtualObsInterval" name="virtual.observatory.interval"
                       value="<%= obs.interval || '1m' %>" placeholder="1m">
                <small><%= t('nodes.virtualObsIntervalHint') %></small>
            </div>
            <div class="form-group">
                <label for="virtualObsTimeout"><%= t('nodes.virtualObsTimeout') %></label>
                <input type="text" id="virtualObsTimeout" name="virtual.observatory.timeout"
                       value="<%= obs.timeout || '5s' %>" placeholder="5s">
                <small><%= t('nodes.virtualObsTimeoutHint') %></small>
            </div>
            <div class="form-group" id="virtualObsSamplingGroup" style="<%= strategy === 'leastLoad' ? '' : 'display:none' %>">
                <label for="virtualObsSampling"><%= t('nodes.virtualObsSampling') %></label>
                <input type="number" id="virtualObsSampling" name="virtual.observatory.sampling"
                       value="<%= obs.sampling || 3 %>" min="1" max="100">
                <small><%= t('nodes.virtualObsSamplingHint') %></small>
            </div>
        </div>
    </div>

    <div class="nf-group">
        <div class="nf-group__title">
            <i class="ti ti-activity"></i> <%= t('nodes.virtualUrltest') %>
            <a class="docs-hint-link" href="https://sing-box.sagernet.org/configuration/outbound/urltest/" target="_blank" rel="noopener noreferrer" title="sing-box docs">ⓘ</a>
        </div>
        <small class="nf-section__hint"><%= t('nodes.virtualUrltestHint') %></small>

        <div class="form-row">
            <div class="form-group">
                <label for="virtualTolerance"><%= t('nodes.virtualTolerance') %></label>
                <input type="number" id="virtualTolerance" name="virtual.tolerance"
                       value="<%= tolerance %>" min="0" max="5000">
                <small><%= t('nodes.virtualToleranceHint') %></small>
            </div>
            <div class="form-group">
                <label for="virtualIdleTimeout"><%= t('nodes.virtualIdleTimeout') %></label>
                <input type="text" id="virtualIdleTimeout" name="virtual.idleTimeout"
                       value="<%= idleTimeout %>" placeholder="30m">
                <small><%= t('nodes.virtualIdleTimeoutHint') %></small>
            </div>
        </div>

        <div class="form-group">
            <label class="nf-tag">
                <input type="checkbox" name="virtual.interruptExistConnections" <%= interruptExistConnections ? 'checked' : '' %>>
                <span><%= t('nodes.virtualInterruptExisting') %></span>
            </label>
            <small style="display:block;margin-top:6px;"><%= t('nodes.virtualInterruptExistingHint') %></small>
        </div>
    </div>
</div>

<script>
function virtualOnSelectModeChange(mode) {
    document.getElementById('virtualManualGroup').style.display = mode === 'manual' ? '' : 'none';
    document.getElementById('virtualGroupGroup').style.display = mode === 'group' ? '' : 'none';
}
function virtualSelectStrategy(id) {
    document.getElementById('virtualStrategy').value = id;
    document.getElementById('virtualObservatorySection').style.display =
        (id === 'leastPing' || id === 'leastLoad') ? '' : 'none';
    const sampling = document.getElementById('virtualObsSamplingGroup');
    if (sampling) sampling.style.display = id === 'leastLoad' ? '' : 'none';
}
</script>
