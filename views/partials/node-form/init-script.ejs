<%# Module inside the access pane: runs once on the server during setup. %>
<details class="nf-module <%= node?.initScript ? 'is-on' : '' %>" id="initScriptDetails" <%= node?.initScript ? 'open' : '' %>>
    <summary class="nf-module__head">
        <span class="nf-module__ico"><i class="ti ti-terminal"></i></span>
        <span class="nf-module__text">
            <span class="nf-module__title"><%= t('nodes.initScript') %></span>
            <span class="nf-module__sub"><%= t('nodes.initScriptHint') %></span>
            <span class="nf-chips">
                <span class="nf-chip"><i class="ti ti-terminal"></i><%= node?.initScript ? t('common.enabled') : t('nodes.off') %></span>
            </span>
        </span>
        <i class="ti ti-chevron-down nf-module__chev"></i>
    </summary>
    <div class="nf-module__body">
        <% if (lastInitScript && !node?.initScript) { %>
        <div style="display:flex;justify-content:flex-end;margin-bottom:6px;">
            <button type="button" class="btn btn-sm btn-secondary" onclick="useLastInitScript()" id="btnUseLastScript">
                <i class="ti ti-history"></i> <%= t('nodes.initScriptUseLast') %>
            </button>
        </div>
        <% } %>
        <div class="form-group">
            <textarea
                id="initScript"
                name="initScript"
                rows="8"
                class="code-textarea"
                placeholder="#!/bin/bash&#10;# e.g. enable BBR, configure swap, install packages&#10;sysctl -w net.core.default_qdisc=fq&#10;sysctl -w net.ipv4.tcp_congestion_control=bbr"
            ><%= node?.initScript || '' %></textarea>
        </div>
    </div>
</details>
