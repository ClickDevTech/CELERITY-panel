// Serialize a row's checked fingerprint-pool checkboxes into its sibling hidden
// CSV input. The hidden input (not the checkboxes) is submitted so the parallel
// xray_extra_*[] arrays stay index-aligned (one value per row).
function syncExtraFingerprintPool(el) {
    const card = _findExtraCard(el);
    if (!card) return;
    const hidden = card.querySelector('input.extra-fp-pool-csv');
    if (!hidden) return;
    const values = Array.from(card.querySelectorAll('input.extra-fp-pool-cb:checked')).map(c => c.value);
    hidden.value = values.join(',');
