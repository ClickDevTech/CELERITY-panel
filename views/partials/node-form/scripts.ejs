// Toggle an extra inbound's fingerprint UI between "single" and "pool" modes.
// The hidden CSV input is the source of truth: filled from the checked boxes in
// pool mode, emptied in single mode (so the pool is cleared on save).
function updateExtraFingerprintModeUI(selectEl) {
    const card = _findExtraCard(selectEl);
    if (!card) return;
    const mode = selectEl.value;
    const single = card.querySelector('.extra-fp-single');
    const poolBlock = card.querySelector('.extra-fp-pool-block');
    const hidden = card.querySelector('input.extra-fp-pool-csv');
    if (single) single.style.display = mode === 'single' ? '' : 'none';
    if (poolBlock) poolBlock.style.display = mode === 'pool' ? '' : 'none';
    if (!hidden) return;
    hidden.value = (mode === 'pool')
        ? Array.from(card.querySelectorAll('input.extra-fp-pool-cb:checked')).map(c => c.value).join(',')
        : '';
}

function updateExtraInboundTitle(input) {
    const card = _findExtraCard(input);
    if (!card) return;
    const title = card.querySelector('.extra-inbound-title');
    if (title) {
        const v = String(input.value || '').trim();
        const idx = parseInt(card.dataset.extraIdx || '0', 10);
        title.textContent = v || ((i18n.xrayExtraInbound || 'Extra inbound') + ' #' + (idx + 1));
    }
}

async function generateExtraXrayKeys(btn) {
    const card = _findExtraCard(btn);
    if (!card) return;
    if (!confirm(i18n.xrayGenerateKeysConfirm)) return;
    const original = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="ti ti-loader-2"></i>';
    try {
        const res = await fetch('/panel/nodes/generate-reality-keys', {
            method: 'POST',
            credentials: 'include',
        });
        const data = await res.json();
        if (data && data.success) {
            const priv = card.querySelector('.extra-reality-priv');
            const pub = card.querySelector('.extra-reality-pub');
            if (priv) priv.value = data.privateKey;
            if (pub) pub.value = data.publicKey;
        } else {
            alert(i18n.error + ': ' + ((data && data.error) || 'Unknown error'));
        }
    } catch (err) {
        alert(i18n.error + ': ' + err.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = original;
    }
}

