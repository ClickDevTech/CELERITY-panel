// Mirrors CDN_EDGES_MAX in src/utils/cdnConfig.js.
const CDN_EDGES_MAX = 32;

function updateCdnInboundOptions() {
    const originId = document.getElementById('cdnOriginNode')?.value || '';
    const select = document.getElementById('cdnOriginInbound');
    if (!select) return;
    let firstCompatible = null;
    let selectedVisible = false;
    Array.from(select.options).forEach(option => {
        const visible = !!originId && option.dataset.origin === originId;
        const compatible = option.dataset.compatible !== 'false';
        option.hidden = !visible;
        option.disabled = !visible || !compatible;
        if (visible && compatible && !firstCompatible) firstCompatible = option;
        if (visible && compatible && option.selected) selectedVisible = true;
    });
    if (!selectedVisible && firstCompatible) firstCompatible.selected = true;
    updateCdnXhttpModeUI();
    syncCdnPathHint();
    updateCdnConnectionPreview();
}

function updateCdnXhttpModeUI() {
    const option = document.getElementById('cdnOriginInbound')?.selectedOptions?.[0];
    const select = document.getElementById('cdnXhttpMode');
    const group = document.getElementById('cdnXhttpModeGroup');
    if (!select || !group) return;

    const enabled = option?.dataset.transport === 'xhttp';
    if (!enabled) {
        if (!select.disabled) select.dataset.lastValue = select.value;
        select.value = '';
    } else if (select.disabled && select.dataset.lastValue) {
        select.value = select.dataset.lastValue;
    }
    select.disabled = !enabled;
    group.style.display = enabled ? '' : 'none';
}

function markCdnFieldManual(input) {
    const autoValue = input?.dataset.cdnAutoValue || '';
    if (!input) return;
    input.dataset.cdnManual = input.value.trim() && input.value.trim() !== autoValue ? '1' : '';
}

function syncCdnDomainDefaults() {
    const domain = document.getElementById('cdnDomain')?.value.trim() || '';
    ['cdnSni', 'cdnHost'].forEach(id => {
        const input = document.getElementById(id);
        if (!input) return;
        if (input.dataset.cdnInitialized !== '1') {
            input.dataset.cdnInitialized = '1';
            input.dataset.cdnManual = input.value.trim() && input.value.trim() !== domain ? '1' : '';
            input.dataset.cdnAutoValue = domain;
        }
        const previousAuto = input.dataset.cdnAutoValue || '';
        if (input.dataset.cdnManual !== '1' && (!input.value.trim() || input.value.trim() === previousAuto)) {
            input.value = domain;
        }
        input.dataset.cdnAutoValue = domain;
    });
}

function updateCdnConnectionPreview() {
    const option = document.getElementById('cdnOriginInbound')?.selectedOptions?.[0];
    const domain = document.getElementById('cdnDomain')?.value.trim() || '';
    const port = document.getElementById('cdnPort')?.value || '443';
    const sni = document.getElementById('cdnSni')?.value.trim() || domain;
    const host = document.getElementById('cdnHost')?.value.trim() || domain;
    const pathInput = document.getElementById('cdnPath')?.value.trim() || '';
    const originPath = option?.dataset.path || '/';
    const effectivePath = pathInput || originPath;
    const transport = option?.dataset.transport || '';
    const xhttpMode = document.getElementById('cdnXhttpMode')?.value
        || option?.dataset.xhttpMode
        || '';
    const originName = option?.dataset.originName || '';
    const inboundLabel = option?.dataset.inboundLabel || '';
    const originPort = option?.dataset.port || '';
    const enabledEdges = Array.from(document.querySelectorAll('input[name="cdn_edge_enabled"]:checked')).length;

    const pool = document.querySelectorAll('#cdnFingerprintPicker input[data-fingerprint-pool-value]:checked');
    const poolMode = document.querySelector('#cdnFingerprintPicker input[type="radio"]:checked')?.value === 'pool';
    const fingerprint = poolMode
        ? `${pool.length}× fingerprint`
        : (document.getElementById('cdnFingerprint')?.value || 'chrome');

    const setText = (id, value) => {
        const element = document.getElementById(id);
        if (element) element.textContent = value || '—';
    };
    const clientAddress = domain || (enabledEdges ? `${enabledEdges} edge` : '');
    setText('cdnConnectionClient', clientAddress ? `${clientAddress}:${port}` : '');
    setText('cdnConnectionTls', `TLS · SNI ${sni || '—'} · ${fingerprint}`);
    setText('cdnConnectionFront', host || domain || '');
    setText(
        'cdnConnectionPath',
        transport ? `${transport.toUpperCase()}${transport === 'xhttp' && xhttpMode ? ` · ${xhttpMode}` : ''} · ${effectivePath}` : ''
    );
    setText('cdnConnectionOrigin', originName ? `${originName}${originPort ? `:${originPort}` : ''}` : '');
    setText('cdnConnectionInbound', inboundLabel);

    const mihomo = document.getElementById('cdnMihomoFormat');
    const mihomoSupported = option?.dataset.uplinkMethod !== 'GET';
    if (mihomo) {
        mihomo.className = `badge badge-${mihomoSupported ? 'success' : 'warning'}`;
        mihomo.textContent = mihomoSupported ? 'Mihomo' : i18n.cdnMihomoExcluded;
    }

    const path = document.getElementById('cdnPath');
    const ready = !!option && option.dataset.compatible !== 'false'
        && !!clientAddress && !!sni && (!path || path.validity.valid);
    const state = document.getElementById('cdnConnectionState');
    if (state) {
        state.className = `badge badge-${ready ? 'success' : 'secondary'}`;
        state.textContent = ready ? i18n.cdnConnectionReady : i18n.cdnConnectionIncomplete;
    }
}

// Mirrors validateCdnClientPath in src/utils/cdnConfig.js. The rule is not
// guessable — with the default placements Xray reads the segment after the
// inbound path as the session ID, so a longer client path breaks every session
// at once — and finding that out after a save costs a debugging session.
function syncCdnPathHint() {
    const input = document.getElementById('cdnPath');
    if (!input) return;
    // Same reason as in syncCdnRequired: never leave a validity message behind
    // on a field the operator cannot see.
    if (document.querySelector('input[name="type"]:checked')?.value !== 'cdn') {
        input.setCustomValidity('');
        return;
    }
    const option = document.getElementById('cdnOriginInbound')?.selectedOptions?.[0];
    const transport = option?.dataset.transport || '';
    const originPath = option?.dataset.path || '/';
    const value = input.value.trim();

    if (transport === 'xhttp') {
        const stripSlash = path => (path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path);
        const prefix = originPath.endsWith('/') ? originPath : originPath + '/';
        if (option?.dataset.markersInPath === 'true') {
            input.placeholder = originPath;
            input.setCustomValidity(
                !value || stripSlash(value) === stripSlash(originPath)
                    ? ''
                    : i18n.cdnPathMustMatchOrigin.replace('{path}', originPath)
            );
        } else {
            input.placeholder = prefix + 'events.php';
            input.setCustomValidity(
                !value || stripSlash(value) === stripSlash(originPath) || value.startsWith(prefix)
                    ? ''
                    : i18n.cdnPathMustExtend.replace('{prefix}', prefix)
            );
        }
    } else if (transport === 'ws') {
        input.placeholder = originPath;
        input.setCustomValidity(
            !value || value === originPath ? '' : i18n.cdnPathMustEqual.replace('{path}', originPath)
        );
    } else {
        input.placeholder = '';
        input.setCustomValidity(value ? i18n.cdnPathUnsupported : '');
    }
    updateCdnConnectionPreview();
}

function updateCdnTlsUi() {
    const enabled = document.getElementById('cdnSecurity')?.value === 'tls';
    document.querySelectorAll('.cdn-tls-only').forEach(element => {
        element.style.display = enabled ? '' : 'none';
    });
    updateCdnConnectionPreview();
}

function addCdnEdge(values = {}) {
    const container = document.getElementById('cdnEdgesContainer');
    const template = document.getElementById('cdnEdgeTemplate');
    if (!container || !template) return false;
    if (container.children.length >= CDN_EDGES_MAX) {
        const status = document.getElementById('cdnResolveStatus');
        if (status) status.textContent = i18n.cdnEdgeLimit.replace('{max}', String(CDN_EDGES_MAX));
        return false;
    }
    const id = (window.crypto && window.crypto.randomUUID)
        ? window.crypto.randomUUID()
        : `edge-${Date.now()}-${Math.random().toString(16).slice(2)}`;
    const fragment = template.content.cloneNode(true);
    const row = fragment.querySelector('.cdn-edge-row');
    const edgeId = String(values.id || id);
    row.querySelector('input[name="cdn_edge_id"]').value = edgeId;
    row.querySelector('input[name="cdn_edge_label"]').value = values.label || '';
    row.querySelector('input[name="cdn_edge_address"]').value = values.address || '';
    const enabled = row.querySelector('input[name="cdn_edge_enabled"]');
    enabled.value = edgeId;
    enabled.checked = values.enabled !== false;
    container.appendChild(fragment);
    syncCdnRequired(document.querySelector('input[name="type"]:checked')?.value === 'cdn');
    updateCdnConnectionPreview();
    return true;
}

function removeCdnEdge(button) {
    button.closest('.cdn-edge-row')?.remove();
    updateCdnConnectionPreview();
}

async function resolveCdnEdges() {
    const domain = document.getElementById('cdnDomain')?.value.trim();
    const status = document.getElementById('cdnResolveStatus');
    const button = document.getElementById('cdnResolveBtn');
    const icon = button?.querySelector('i');
    if (!domain) {
        if (status) status.textContent = i18n.cdnDomainRequired;
        return;
    }
    if (status) status.textContent = i18n.checking;
    if (button) button.disabled = true;
    if (icon) icon.classList.add('spin');
    try {
        const response = await fetch(`/panel/nodes/resolve-cdn?domain=${encodeURIComponent(domain)}`, {
            credentials: 'include',
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || `HTTP ${response.status}`);
        const existing = new Set(
            Array.from(document.querySelectorAll('input[name="cdn_edge_address"]'))
                .map(input => input.value.trim())
                .filter(Boolean)
        );
        const container = document.getElementById('cdnEdgesContainer');
        let added = 0;
        data.addresses.forEach(address => {
            if (existing.has(address)) return;
            const label = `Edge ${(container ? container.children.length : 0) + 1}`;
            if (addCdnEdge({ address, label })) {
                existing.add(address);
                added++;
            }
        });
        if (status) {
            status.textContent = container && container.children.length >= CDN_EDGES_MAX
                ? i18n.cdnEdgeLimit.replace('{max}', String(CDN_EDGES_MAX))
                : i18n.cdnResolvedSources
                    .replace('{found}', String(data.addresses.length))
                    .replace('{count}', String(added))
                    .replace('{sources}', String((data.sources || []).length))
                    .replace('{total}', String((data.attemptedSources || []).length));
        }
        syncCdnDomainDefaults();
        updateCdnConnectionPreview();
    } catch (error) {
        if (status) status.textContent = `${i18n.error}: ${error.message}`;
    } finally {
        if (button) button.disabled = false;
        if (icon) icon.classList.remove('spin');
    }
}

