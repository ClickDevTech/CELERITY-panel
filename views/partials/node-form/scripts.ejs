document.getElementById('nodeForm')?.addEventListener('submit', async function(event) {
    const type = document.querySelector('input[name="type"]:checked')?.value;
    if (type !== 'cdn') return;

    event.preventDefault();
    if (this.dataset.saving === '1') return;
    if (!this.reportValidity()) return;
    this.dataset.saving = '1';

    const submit = this.querySelector('button[type="submit"]');
    const inlineError = document.getElementById('cdnInlineError');
    const state = document.getElementById('cdnConnectionState');
    const originalSubmitHtml = submit?.innerHTML || '';
    if (submit) {
        submit.disabled = true;
        submit.innerHTML = `<i class="ti ti-loader-2 spin"></i> ${i18n.cdnSaving}`;
    }
    if (inlineError) inlineError.style.display = 'none';
    if (state) {
        state.className = 'badge badge-warning';
        state.textContent = i18n.cdnSaving;
    }

    try {
        const body = new URLSearchParams();
        new FormData(this).forEach((value, key) => {
            if (typeof value === 'string') body.append(key, value);
        });
        const response = await fetch(this.action, {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
            },
            credentials: 'same-origin',
            body,
        });
        const result = await response.json();
        if (!response.ok || !result.success) {
            throw new Error(result.error || i18n.cdnSaveFailed);
        }
        window.location.assign(result.redirect);
    } catch (error) {
        if (inlineError) {
            inlineError.textContent = error.message || i18n.cdnSaveFailed;
            inlineError.style.display = '';
            inlineError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        updateCdnConnectionPreview();
        delete this.dataset.saving;
        if (submit) {
            submit.disabled = false;
            submit.innerHTML = originalSubmitHtml;
        }
    }
});

