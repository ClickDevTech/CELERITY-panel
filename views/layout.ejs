<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0a0a0b">
    <title><%= title %> | VamPanel</title>
    <%- include('partials/favicon') %>
    <link rel="stylesheet" href="/fonts/fonts.css?v=1">
    <link rel="stylesheet" href="/css/style.min.css?v=7">
    <link rel="preload" href="/vendor/tabler/fonts/tabler-icons.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/vendor/tabler/tabler-icons.min.css">
</head>
<body>
    <a class="skip-link" href="#mainContent"><%= t('common.skipToContent') || 'Skip to content' %></a>
    <div class="vam-fog" id="vamFog" aria-hidden="true"><span></span><span></span><span></span></div>

    <div class="app">
        <main class="content" id="mainContent">
            <div class="island-wrap">
                <nav class="island" id="island" aria-label="Main" tabindex="0" aria-expanded="false">
                    <span class="island-word">VAMPANEL</span>
                    <span class="island-dot online" title="<%= t('common.online') %>"></span>
                    <div class="island-nav" id="islandNav">
                        <a href="/panel" class="island-link<%= page === 'dashboard' ? ' active' : '' %>"<%= page === 'dashboard' ? ' aria-current="page"' : '' %>>
                            <i class="ti ti-layout-dashboard"></i><span><%= t('nav.dashboard') %></span>
                        </a>
                        <a href="/panel/stats" class="island-link<%= page === 'stats' ? ' active' : '' %>"<%= page === 'stats' ? ' aria-current="page"' : '' %>>
                            <i class="ti ti-trending-up"></i><span><%= t('nav.stats') %></span>
                        </a>
                        <a href="/panel/nodes" class="island-link<%= page === 'nodes' ? ' active' : '' %>"<%= page === 'nodes' ? ' aria-current="page"' : '' %>>
                            <i class="ti ti-server"></i><span><%= t('nav.nodes') %></span>
                        </a>
                        <a href="/panel/groups" class="island-link<%= page === 'groups' ? ' active' : '' %>"<%= page === 'groups' ? ' aria-current="page"' : '' %>>
                            <i class="ti ti-folder"></i><span><%= t('nav.groups') %></span>
                        </a>
                        <a href="/panel/users" class="island-link<%= page === 'users' ? ' active' : '' %>"<%= page === 'users' ? ' aria-current="page"' : '' %>>
                            <i class="ti ti-users"></i><span><%= t('nav.users') %></span>
                        </a>
                        <% if (typeof accessLogsEnabled !== 'undefined' && accessLogsEnabled) { %>
                        <a href="/panel/access-logs" class="island-link<%= page === 'accessLogs' ? ' active' : '' %>"<%= page === 'accessLogs' ? ' aria-current="page"' : '' %>>
                            <i class="ti ti-list-search"></i><span><%= t('nav.accessLogs') %></span>
                        </a>
                        <% } %>
                        <% if (typeof probesEnabled !== 'undefined' && probesEnabled) { %>
                        <a href="/panel/probes" class="island-link<%= page === 'probes' ? ' active' : '' %>"<%= page === 'probes' ? ' aria-current="page"' : '' %>>
                            <i class="ti ti-radar"></i><span><%= t('nav.probes') %></span>
                        </a>
                        <% } %>
                        <a href="/panel/settings" class="island-link<%= page === 'settings' ? ' active' : '' %>"<%= page === 'settings' ? ' aria-current="page"' : '' %>>
                            <i class="ti ti-settings"></i><span><%= t('nav.settings') %></span>
                        </a>
                    </div>
                </nav>
            </div>
            <header class="topbar">
                <div class="topbar-left">
                    <h1><%= title %></h1>
                </div>
                <div class="topbar-right">
                    <span class="status-pill"><span class="status-dot online"></span><span class="status-text"><%= t('common.online') %></span></span>
                    <a href="/panel/logout" class="icon-btn" title="<%= t('nav.logout') %>" aria-label="<%= t('nav.logout') %>"><i class="ti ti-logout"></i></a>
                </div>
            </header>
            <div class="main-content">
                <%- content %>
            </div>
        </main>
    </div>

    <div class="toast-stack" id="toastStack" aria-live="polite"></div>
    <div id="toast" class="toast" role="status"></div>

    <script defer src="/js/app.js?v=7"></script>
</body>
</html>
