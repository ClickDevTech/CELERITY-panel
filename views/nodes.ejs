<%
const nodeMetaLabels = {
    transportTitle: t('nodes.nodeMetaTransport'),
    securityTitle: t('nodes.nodeMetaSecurity'),
    certificateTitle: t('nodes.nodeMetaCertificate'),
    certPanel: t('nodes.nodeMetaCertPanel'),
    certAcme: t('nodes.nodeMetaCertAcme'),
    certManual: t('nodes.nodeMetaCertManual'),
    certSelfSigned: t('nodes.nodeMetaCertSelfSigned'),
    certFiles: t('nodes.nodeMetaCertFiles'),
    securityNone: t('nodes.nodeMetaSecurityNone'),
    virtualTransport: t('nodes.nodeMetaVirtual'),
};
function nodeMetaFor(node) {
    if (typeof buildNodeUiMeta !== 'function') {
        return { displayDomain: node?.domain || '', badges: [] };
    }
    return buildNodeUiMeta(node, {
        panelDomain: typeof panelDomain === 'string' ? panelDomain : '',
        labels: nodeMetaLabels,
    });
}
%>

<div class="page-header sticky-header nodes-toolbar-header">
    <div class="page-header-left">
        <div class="view-tabs">
            <button type="button" class="view-tab active" id="tabList" onclick="switchNodesView('list')">
                <i class="ti ti-list"></i> <%= t('nodes.title') %>
                <span class="tab-badge"><%= nodes.length %></span>
            </button>
            <button type="button" class="view-tab" id="tabNetwork" onclick="switchNodesView('network')">
                <i class="ti ti-topology-star-3"></i> <%= t('network.title') %>
                <span class="beta-badge" style="margin-left:4px"><%= t('network.betaBadge') %></span>
                <% if (linksCount) { %><span class="tab-badge"><%= linksCount %></span><% } %>
            </button>
            <a class="view-tab" href="/panel/wg-panels">
                <img class="wg-brand-icon" src="/img/wireguard.svg" alt="" aria-hidden="true"> <%= t('nav.wgPanels') %>
                <span class="tab-badge"><%= typeof wgPanelsCount === 'number' ? wgPanelsCount : 0 %></span>
            </a>
        </div>
    </div>
    <div class="page-header-center" id="listFilters">
        <div class="filters-bar">
            <select id="filterStatus" class="filter-select" onchange="applyFilters()">
                <option value=""><%= t('nodes.allStatuses') %></option>
                <option value="online"><%= t('nodes.statusOnline') %></option>
                <option value="offline"><%= t('nodes.statusOffline') %></option>
                <option value="error"><%= t('nodes.statusError') %></option>
            </select>
            <select id="filterGroup" class="filter-select" onchange="applyFilters()">
                <option value=""><%= t('users.allGroups') %></option>
                <% if (groups) { groups.forEach(group => { %>
                <option value="<%= group._id %>"><%= group.name %></option>
                <% }); } %>
            </select>
            <select id="sortNodes" class="filter-select" onchange="sortNodesTable()">
                <option value="ranking"><%= t('nodes.sortByPriority') %></option>
                <option value="name"><%= t('nodes.sortByName') %></option>
                <option value="online"><%= t('nodes.sortByOnline') %></option>
                <option value="status"><%= t('nodes.sortByStatus') %></option>
            </select>
            <span id="resultsCount" class="filter-count"></span>
        </div>
    </div>
    <div class="page-header-center" id="networkToolbar" style="display:none">
        <div class="filters-bar">
            <button class="btn btn-sm" id="btnAutoLayout" title="<%= t('network.autoLayout') %>">
                <i class="ti ti-layout-distribute-horizontal"></i> <%= t('network.autoLayout') %>
            </button>
            <button class="btn btn-sm" id="btnFitView" title="<%= t('network.fitView') %>">
                <i class="ti ti-arrows-maximize"></i>
            </button>
            <button class="btn btn-sm" id="btnRefresh" title="<%= t('network.refresh') %>">
                <i class="ti ti-refresh"></i>
            </button>
        </div>
    </div>
    <div class="page-header-right" id="listActions">
        <a href="/panel/broadcast" target="_blank" class="btn"><i class="ti ti-broadcast"></i> <%= t('nodes.broadcastTerminal') %></a>
        <a href="/panel/nodes/add" class="btn btn-primary"><i class="ti ti-server-2"></i> <%= t('nodes.addNode') %></a>
    </div>
    <div class="page-header-right" id="networkActions" style="display:none">
        <button class="btn btn-primary" id="btnAddLink"><i class="ti ti-plus"></i> <%= t('network.addLink') %></button>
    </div>
</div>

<div id="viewList">
<div class="card">
    <div class="card-body no-padding">
        <div class="table-wrapper">
            <table class="table" id="nodesTable">
                <thead>
                    <tr>
                        <th style="width:32px;text-align:center" title="<%= t('nodes.sortByPriority') %>">#</th>
                        <th><%= t('common.name') %></th>
                        <th><%= t('common.server') %></th>
                        <th><%= t('common.ports') %></th>
                        <th><%= t('common.status') %></th>
                        <th class="node-active-col"><%= t('nodes.activeColumn') %></th>
                        <th><%= t('common.online') %></th>
                        <th><%= t('nodes.groups') %></th>
                        <th><%= t('nodes.nodeInfo') %></th>
                        <th><%= t('common.actions') %></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (nodes.length === 0) { %>
                    <tr>
                        <td colspan="10" class="text-center text-muted">
                            <div class="empty-state">
                                <span class="empty-icon"><i class="ti ti-server"></i></span>
                                <p><%= t('nodes.noNodes') %></p>
                                <a href="/panel/nodes/add" class="btn btn-primary"><i class="ti ti-plus"></i> <%= t('nodes.addFirstNode') %></a>
                            </div>
                        </td>
                    </tr>
                    <% } %>
                    <% nodes.forEach(node => { 
                        const groupIds = (node.groups || []).map(g => g._id?.toString() || g.toString()).join(',');
                        const nodeMeta = nodeMetaFor(node);
                    %>
                    <tr class="node-row"
                        data-status="<%= node.status %>"
                        data-groups="<%= groupIds %>"
                        data-active="<%= node.active %>"
                        data-type="<%= node.type || 'hysteria' %>"
                        data-id="<%= node._id %>"
                        data-name="<%= (node.name || '').replace(/"/g, '&quot;') %>"
                        data-ranking="<%= node.rankingCoefficient || 1 %>"
                        data-online="<%= node.onlineUsers || 0 %>">
                        <td class="drag-handle" title="<%= t('nodes.dragToReorder') %>" style="text-align:center"><span class="ranking-num"><%= node.rankingCoefficient || 1 %></span><i class="ti ti-grip-vertical" style="color:var(--text-muted)"></i></td>
                        <td>
                            <div class="node-name-cell">
                                <% if (node.flag) { %><span class="node-flag"><%= node.flag %></span><% } %>
                                <div>
                                    <strong><%= node.name %></strong>
                                    <% if (node.type === 'xray') { %>
                                    <img src="/img/xray.svg" alt="Xray" title="Xray VLESS" style="width:16px;height:16px;vertical-align:middle;margin-left:6px;opacity:0.7;">
                                    <% } else if (node.type === 'virtual') { %>
                                    <i class="ti ti-route" title="Virtual / Balancer" style="font-size:16px;vertical-align:middle;margin-left:6px;opacity:0.7;"></i>
                                    <% } else { %>
                                    <img src="/img/hysteria.svg" alt="Hysteria" title="Hysteria 2" style="width:16px;height:16px;vertical-align:middle;margin-left:6px;opacity:0.7;">
                                    <% } %>
                                    <% if (node.type !== 'virtual' && (ipProtocolCount || {})[node.ip] > 1) { %>
                                    <span class="badge-cascade relay" title="<%= t('nodes.dualProtocol') %>"><i class="ti ti-layers-subtract" style="font-size:10px;"></i> dual</span>
                                    <% } %>
                                    <% if (node.cascadeRole && node.cascadeRole !== 'standalone') { %>
                                    <span class="badge-cascade <%= node.cascadeRole %>"><%= node.cascadeRole.toUpperCase() %></span>
                                    <% } %>
                                    <% if (nodeMeta.badges && nodeMeta.badges.length > 0) { %>
                                    <div class="node-meta-strip">
                                        <% nodeMeta.badges.forEach(badge => { %>
                                        <span class="<%= badge.className %>" title="<%= badge.title %>">
                                            <i class="<%= badge.icon %>"></i><%= badge.label %>
                                        </span>
                                        <% }); %>
                                    </div>
                                    <% } %>
                                    <% if (nodeMeta.displayDomain) { %>
                                    <small class="node-domain-line"><i class="ti ti-world"></i> <%= nodeMeta.displayDomain %></small>
                                    <% } %>
                                    <% if (node.comment) { %>
                                    <br><small class="node-comment" title="<%= node.comment %>"><i class="ti ti-message-circle"></i> <%= node.comment %></small>
                                    <% } %>
                                </div>
                            </div>
                        </td>
                        <td><% if (node.type === 'virtual') { %><span class="text-muted">—</span><% } else { %><code><%= node.ip %></code><% } %></td>
                        <td>
                            <% if (node.type === 'virtual') { %>
                                <span class="text-muted" title="<%= (node.virtual && node.virtual.strategy) || 'leastLoad' %>">
                                    <i class="ti ti-route"></i> <%= (node.virtual && node.virtual.strategy) || 'leastLoad' %>
                                </span>
                            <% } else if (node.type === 'xray' && node.xray && Array.isArray(node.xray.extraInbounds) && node.xray.extraInbounds.length > 0) { %>
                                <div class="port-chip-list">
                                    <span class="port-chip" title="<%= (node.xray.transport || 'tcp') %>/<%= (node.xray.security || 'reality') %>"><%= node.port %></span>
                                    <% node.xray.extraInbounds.forEach(function(ei) { %>
                                        <span class="port-chip port-chip-extra" title="<%= ei.transport %>/<%= ei.security %><%= ei.label ? ' — ' + ei.label : '' %>"><%= ei.port %></span>
                                    <% }); %>
                                </div>
                            <% } else { %>
                                <code><%= node.port %></code>
                            <% } %>
                            <% if (node.type !== 'virtual' && node.portRange) { %>
                            <br><small class="text-muted">hop: <%= node.portRange %></small>
                            <% } %>
                        </td>
                        <td>
                            <% if (node.type === 'virtual') { %>
                                <span class="badge badge-secondary" data-node-status-badge data-node-id="<%= node._id %>" data-node-virtual-status="true" title="<%= t('nodes.virtualNoStatus') %>">virtual</span>
                            <% } else { %>
                                <span class="badge badge-<%= node.status === 'online' ? 'success' : (node.status === 'error' ? 'danger' : 'warning') %>" data-node-status-badge data-node-id="<%= node._id %>">
                                    <%= node.status %>
                                </span>
                            <% } %>
                            <% if (!node.active) { %>
                            <span class="badge badge-secondary node-active-off-badge" data-node-active-off-badge data-node-id="<%= node._id %>"><%= t('nodes.off') %></span>
                            <% } else { %>
                            <span class="badge badge-secondary node-active-off-badge" data-node-active-off-badge data-node-id="<%= node._id %>" style="display:none"><%= t('nodes.off') %></span>
                            <% } %>
                        </td>
                        <td class="node-active-col">
                            <label class="toggle-switch node-active-toggle" title="<%= node.active ? t('nodes.disableActiveTitle') : t('nodes.enableActiveTitle') %>">
                                <input type="checkbox"
                                       data-node-active-input
                                       data-node-id="<%= node._id %>"
                                       data-node-name="<%= node.name %>"
                                       aria-label="<%= node.active ? t('nodes.disableActiveAria') : t('nodes.enableActiveAria') %>: <%= node.name %>"
                                       <%= node.active ? 'checked' : '' %>
                                       onchange="toggleNodeActive('<%= node._id %>', this.checked)">
                                <span class="toggle-slider"></span>
                            </label>
                        </td>
                        <td>
                            <% if (node.type === 'virtual') { %>
                                <span class="text-muted">—</span>
                            <% } else { %>
                                <span class="<%= node.maxOnlineUsers && node.onlineUsers >= node.maxOnlineUsers ? 'text-danger' : '' %>">
                                    <%= node.onlineUsers || 0 %><% if (node.maxOnlineUsers) { %>/<%= node.maxOnlineUsers %><% } %>
                                </span>
                            <% } %>
                        </td>
                        <td>
                            <% if (node.groups && node.groups.length > 0) { %>
                                <% node.groups.slice(0,2).forEach(group => { %>
                                    <span class="group-tag-sm" style="background: <%= group.color %>20; border-color: <%= group.color %>; color: <%= group.color %>">
                                        <%= group.name %>
                                    </span>
                                <% }); %>
                                <% if (node.groups.length > 2) { %>
                                    <span class="group-more">+<%= node.groups.length - 2 %></span>
                                <% } %>
                            <% } else { %>
                                <span class="text-muted"><%= t('common.all') %></span>
                            <% } %>
                        </td>
                        <td class="node-info-cell">
                            <% if (node.type === 'xray') { %>
                                <% if (node.xrayVersion) { %>
                                <span class="node-info-badge" title="<%= t('nodes.xrayVersion') %>">
                                    <img src="/img/xray.svg" style="width:12px;height:12px;vertical-align:middle;"> v<%= node.xrayVersion %>
                                </span>
                                <% } %>
                                <span class="node-info-badge badge-agent-<%= node.agentStatus || 'unknown' %>" title="<%= t('nodes.agentStatus') %>">
                                    <i class="ti ti-cpu"></i> <%= node.agentStatus || 'unknown' %>
                                </span>
                            <% } else { %>
                                <span class="text-muted">—</span>
                            <% } %>
                        </td>
                        <td>
                            <div class="node-actions">
                                <% if (node.type !== 'virtual') { %>
                                    <button class="btn-icon" onclick="restartNode('<%= node._id %>')" title="<%= t('nodes.restart') %>" <%= !node.ssh?.password ? 'disabled' : '' %>><i class="ti ti-refresh"></i></button>
                                    <a href="/panel/nodes/<%= node._id %>/terminal" class="btn-icon" title="<%= t('nodes.terminal') %>" <%= !node.ssh?.password ? 'style="pointer-events:none;opacity:0.5"' : '' %>><i class="ti ti-terminal-2"></i></a>
                                <% } %>
                                <a href="/panel/nodes/<%= node._id %>" class="btn-icon" title="<%= t('common.edit') %>"><i class="ti ti-pencil"></i></a>
                                <% if (node.type !== 'virtual' && (ipProtocolCount || {})[node.ip] < 2) { %>
                                <a href="/panel/nodes/add?cloneFrom=<%= node._id %>" class="btn-icon" title="<%= t('nodes.addPairedProtocol') %>"><i class="ti ti-plug-connected"></i></a>
                                <% } %>
                                <button class="btn-icon btn-icon-danger" onclick="deleteNode('<%= node._id %>')" title="<%= t('common.delete') %>"><i class="ti ti-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        
        <!-- Mobile Cards -->
        <div class="mobile-nodes-list">
            <% if (nodes.length === 0) { %>
                <div style="text-align: center; padding: 40px 20px;">
                    <p style="color: var(--text-muted); margin-bottom: 16px;"><%= t('nodes.noNodes') %></p>
                    <a href="/panel/nodes/add" class="btn btn-primary btn-sm"><%= t('nodes.addFirstNode') %></a>
                </div>
            <% } %>
            <% nodes.forEach(node => { 
                const groupIds = (node.groups || []).map(g => g._id?.toString() || g.toString()).join(',');
                const nodeMeta = nodeMetaFor(node);
            %>
                <div class="mobile-node-card node-row-mobile"
                     data-status="<%= node.status %>"
                     data-groups="<%= groupIds %>"
                     data-active="<%= node.active %>"
                     data-type="<%= node.type || 'hysteria' %>"
                     data-id="<%= node._id %>"
                     data-name="<%= (node.name || '').replace(/"/g, '&quot;') %>"
                     data-ranking="<%= node.rankingCoefficient || 1 %>"
                     data-online="<%= node.onlineUsers || 0 %>">
                    <div class="mobile-node-header">
                        <div class="mobile-node-title">
                            <% if (node.flag) { %><span><%= node.flag %></span><% } %>
                            <strong><%= node.name %></strong>
                            <% if (node.type === 'xray') { %>
                            <img src="/img/xray.svg" alt="Xray" title="Xray VLESS" style="width:14px;height:14px;vertical-align:middle;opacity:0.7;">
                            <% } else if (node.type === 'virtual') { %>
                            <i class="ti ti-route" title="Virtual / Balancer" style="font-size:14px;vertical-align:middle;opacity:0.7;"></i>
                            <% } else { %>
                            <img src="/img/hysteria.svg" alt="Hysteria" title="Hysteria 2" style="width:14px;height:14px;vertical-align:middle;opacity:0.7;">
                            <% } %>
                            <code style="font-size: 11px;"><%= node.type === 'virtual' ? ((node.virtual && node.virtual.strategy) || 'leastLoad') : node.ip %></code>
                            <% if (nodeMeta.badges && nodeMeta.badges.length > 0) { %>
                            <div class="node-meta-strip node-meta-strip-mobile">
                                <% nodeMeta.badges.forEach(badge => { %>
                                <span class="<%= badge.className %>" title="<%= badge.title %>">
                                    <i class="<%= badge.icon %>"></i><%= badge.label %>
                                </span>
                                <% }); %>
                            </div>
                            <% } %>
                            <% if (nodeMeta.displayDomain) { %>
                            <small class="node-domain-line"><i class="ti ti-world"></i> <%= nodeMeta.displayDomain %></small>
                            <% } %>
                        </div>
                        <div class="mobile-node-state">
                            <% if (node.type === 'virtual') { %>
                            <span class="badge badge-secondary" data-node-status-badge data-node-id="<%= node._id %>" data-node-virtual-status="true" title="<%= t('nodes.virtualNoStatus') %>">virtual</span>
                            <% } else { %>
                            <span class="badge badge-<%= node.status === 'online' ? 'success' : (node.status === 'error' ? 'danger' : 'warning') %>" data-node-status-badge data-node-id="<%= node._id %>">
                                <%= node.status %>
                            </span>
                            <% } %>
                            <% if (!node.active) { %>
                            <span class="badge badge-secondary node-active-off-badge" data-node-active-off-badge data-node-id="<%= node._id %>"><%= t('nodes.off') %></span>
                            <% } else { %>
                            <span class="badge badge-secondary node-active-off-badge" data-node-active-off-badge data-node-id="<%= node._id %>" style="display:none"><%= t('nodes.off') %></span>
                            <% } %>
                        </div>
                    </div>

                    <% if (node.comment) { %>
                    <div class="node-comment node-comment-mobile" title="<%= node.comment %>">
                        <i class="ti ti-message-circle"></i> <%= node.comment %>
                    </div>
                    <% } %>

                    <div class="mobile-node-stats">
                        <div class="mobile-stat-item">
                            <span class="mobile-stat-label"><%= t('common.online') %></span>
                            <span class="mobile-stat-value"><%= node.onlineUsers || 0 %><% if (node.maxOnlineUsers) { %>/<%= node.maxOnlineUsers %><% } %></span>
                        </div>
                        <div class="mobile-stat-item">
                            <span class="mobile-stat-label"><%= t('common.ports') %></span>
                            <span class="mobile-stat-value"><%= node.type === 'virtual' ? ((node.virtual && node.virtual.strategy) || 'leastLoad') : node.port %></span>
                        </div>
                        <div class="mobile-stat-item mobile-stat-toggle">
                            <span class="mobile-stat-label"><%= t('nodes.activeColumn') %></span>
                            <label class="toggle-switch node-active-toggle" title="<%= node.active ? t('nodes.disableActiveTitle') : t('nodes.enableActiveTitle') %>">
                                <input type="checkbox"
                                       data-node-active-input
                                       data-node-id="<%= node._id %>"
                                       data-node-name="<%= node.name %>"
                                       aria-label="<%= node.active ? t('nodes.disableActiveAria') : t('nodes.enableActiveAria') %>: <%= node.name %>"
                                       <%= node.active ? 'checked' : '' %>
                                       onchange="toggleNodeActive('<%= node._id %>', this.checked)">
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                    </div>
                    
                    <div class="mobile-node-actions">
                        <% if (node.type !== 'virtual') { %>
                        <button class="btn btn-sm" onclick="restartNode('<%= node._id %>')" <%= !node.ssh?.password ? 'disabled' : '' %> title="<%= t('nodes.restart') %>" aria-label="<%= t('nodes.restart') %>"><i class="ti ti-refresh"></i></button>
                        <a href="/panel/nodes/<%= node._id %>/terminal" class="btn btn-sm" title="<%= t('nodes.terminal') %>" aria-label="<%= t('nodes.terminal') %>" <%= !node.ssh?.password ? 'style="pointer-events:none;opacity:0.5"' : '' %>><i class="ti ti-terminal-2"></i></a>
                        <% } %>
                        <a href="/panel/nodes/<%= node._id %>" class="btn btn-sm" title="<%= t('common.edit') %>" aria-label="<%= t('common.edit') %>"><i class="ti ti-pencil"></i></a>
                        <% if (node.type !== 'virtual' && (ipProtocolCount || {})[node.ip] < 2) { %>
                        <a href="/panel/nodes/add?cloneFrom=<%= node._id %>" class="btn btn-sm" title="<%= t('nodes.addPairedProtocol') %>" aria-label="<%= t('nodes.addPairedProtocol') %>"><i class="ti ti-plug-connected"></i></a>
                        <% } %>
                        <button class="btn btn-sm btn-danger" onclick="deleteNode('<%= node._id %>')" title="<%= t('common.delete') %>" aria-label="<%= t('common.delete') %>"><i class="ti ti-trash"></i></button>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</div>
</div><!-- /viewList -->

<!-- Network Map View (hidden by default, loaded on demand) -->
<div id="viewNetwork" style="display:none">
    <link rel="stylesheet" href="/css/network.min.css">
    <div class="network-page">
        <div class="network-container">
            <div id="cy" class="cytoscape-canvas"></div>

            <!-- Empty state -->
            <div class="network-empty" id="networkEmpty" style="display:none">
                <i class="ti ti-topology-star-3"></i>
                <p><%= t('network.noNodesOrLinks') %></p>
            </div>

            <!-- Legend -->
            <div class="network-legend" id="networkLegend">
                <div class="legend-title"><%= t('network.legendTitle') %></div>
                <div class="legend-section">
                    <div class="legend-item"><span class="legend-dot" style="background:#22c55e"></span><%= t('network.legendOnline') %></div>
                    <div class="legend-item"><span class="legend-dot" style="background:#ef4444"></span><%= t('network.legendOffline') %></div>
                    <div class="legend-item"><span class="legend-dot" style="background:#3b82f6"></span><%= t('network.legendDeployed') %></div>
                    <div class="legend-item"><span class="legend-dot" style="background:#64748b"></span><%= t('network.legendPending') %></div>
                </div>
                <div class="legend-divider"></div>
                <div class="legend-section">
                    <div class="legend-item"><span class="legend-role legend-portal"></span><%= t('network.legendPortal') %></div>
                    <div class="legend-item"><span class="legend-role legend-bridge"></span><%= t('network.legendBridge') %></div>
                    <div class="legend-item"><span class="legend-role legend-relay"></span><%= t('network.legendRelay') %></div>
                </div>
                <div class="legend-divider"></div>
                <div class="legend-section">
                    <div class="legend-item"><span class="legend-line legend-line-forward"></span><%= t('network.legendForwardLine') %></div>
                    <div class="legend-item"><span class="legend-line legend-line-reverse"></span><%= t('network.legendReverseLine') %></div>
                </div>
            </div>
        </div>

    </div>

    <!-- Node/Edge info modal -->
    <div class="modal-overlay" id="nodeInfoModal">
        <div class="modal-card modal-card-sm">
            <div class="modal-header">
                <h3 id="nodeInfoTitle"><i class="ti ti-info-circle"></i> <span id="nodeInfoTitleText"></span></h3>
                <button class="modal-close" id="nodeInfoClose"><i class="ti ti-x"></i></button>
            </div>
            <div class="modal-body" id="nodeInfoBody"></div>
        </div>
    </div>

    <!-- Add Link Modal -->
    <div class="modal-overlay" id="addLinkModal">
        <div class="modal-card modal-card-lg">
            <div class="modal-header">
                <h3><i class="ti ti-link"></i> <span id="linkModalTitle"><%= t('network.addLink') %></span> <span class="beta-badge"><%= t('network.betaBadge') %></span></h3>
                <button class="modal-close" id="modalClose"><i class="ti ti-x"></i></button>
            </div>
            <form id="addLinkForm" class="modal-body">
                <input type="hidden" name="linkId" id="linkIdInput" value="">
