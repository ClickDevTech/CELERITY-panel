// ==================== DRAG-AND-DROP REORDER ====================

(function initDragAndDrop() {
    const tbody = document.querySelector('#nodesTable tbody');
    if (!tbody) return;

    let sortableInstance = null;

    // Load vendored SortableJS and initialise once ready
    const script = document.createElement('script');
    script.src = '/js/vendor/Sortable.min.js';
    script.onload = function () {
        sortableInstance = new Sortable(tbody, {
            handle: '.drag-handle',
            animation: 150,
            ghostClass: 'sortable-ghost',
            // Skip filtered-out (hidden) rows — they must not participate in drag
            filter: function (evt, el) {
                return el.style.display === 'none';
            },
            onMove: function (evt) {
                // Prevent dropping next to a hidden row
                if (evt.related && evt.related.style.display === 'none') return false;
            },
            onEnd: async function () {
                // Only send visible rows — hidden rows keep their old ranking
                const rows = Array.from(tbody.querySelectorAll('.node-row'))
                    .filter(r => r.style.display !== 'none');
                const order = rows.map((r, i) => ({
                    id: r.dataset.id,
                    position: i + 1,
                }));

                try {
                    const res = await fetch('/panel/nodes/reorder', {
                        method: 'PATCH',
                        credentials: 'include',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ order }),
                    });
                    const text = await res.text();
                    let json;
                    try { json = JSON.parse(text); } catch { throw new Error('Not JSON: ' + text.substring(0, 120)); }
                    if (!res.ok || !json.success) throw new Error(json.error || 'Reorder failed');
                    rows.forEach((r, i) => {
                        r.dataset.ranking = i + 1;
                        const num = r.querySelector('.ranking-num');
                        if (num) num.textContent = i + 1;
                    });
                    showToast(i18n.reorderSaved || 'Order saved');
                } catch (e) {
                    console.error('[Nodes] Reorder error:', e);
                    showToast(e.message || i18n.reorderFailed, 'error');
                }
            },
        });

        // Disable drag when sort is not by priority (positions would conflict)
        window._nodesSortable = sortableInstance;
    };
    document.body.appendChild(script);

    <% if (loadBalancingEnabled) { %>
    const hint = document.createElement('div');
    hint.className = 'hint';
    hint.style.cssText = 'padding:6px 16px 2px;font-size:12px;color:var(--text-muted)';
    hint.innerHTML = '<i class="ti ti-info-circle"></i> ' + i18n.lbHint;
    const tableWrapper = document.querySelector('#nodesTable')?.closest('.table-wrapper');
    if (tableWrapper) tableWrapper.insertAdjacentElement('beforebegin', hint);
    <% } %>
})();
</script>
