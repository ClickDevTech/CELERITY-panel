<script>
const i18n = {
    confirmDelete: <%- JSON.stringify(t("nodes.confirmDelete")) %>,
    deleteError: <%- JSON.stringify(t("nodes.deleteError")) %>,
    restartSuccess: <%- JSON.stringify(t("nodes.restartSuccess")) %>,
    restartFailed: <%- JSON.stringify(t("nodes.restartFailed")) %>,
    total: <%- JSON.stringify(t("common.total")) %>,
    reorderSaved: <%- JSON.stringify(t("nodes.reorderSaved")) %>,
    reorderFailed: <%- JSON.stringify(t("nodes.reorderFailed")) %>,
    lbHint: <%- JSON.stringify(t("nodes.lbDragHint")) %>,
    nodeEnabled: <%- JSON.stringify(t("nodes.activeEnabled")) %>,
    nodeDisabled: <%- JSON.stringify(t("nodes.activeDisabled")) %>,
    nodeActiveError: <%- JSON.stringify(t("nodes.activeToggleError")) %>,
    nodeEnableTitle: <%- JSON.stringify(t("nodes.enableActiveTitle")) %>,
    nodeDisableTitle: <%- JSON.stringify(t("nodes.disableActiveTitle")) %>,
    nodeEnableAria: <%- JSON.stringify(t("nodes.enableActiveAria")) %>,
    nodeDisableAria: <%- JSON.stringify(t("nodes.disableActiveAria")) %>
};

function applyFilters() {
    const status = document.getElementById('filterStatus').value;
    const group = document.getElementById('filterGroup').value;
    
    let visibleCount = 0;
    
    // Filter desktop table rows
    document.querySelectorAll('.node-row').forEach(row => {
        const rowStatus = row.dataset.status;
        const rowGroups = row.dataset.groups || '';
        
        let show = true;
        if (status && rowStatus !== status) show = false;
        if (group && !rowGroups.includes(group)) show = false;
        
        row.style.display = show ? '' : 'none';
        if (show) visibleCount++;
    });
    
    // Filter mobile cards
    document.querySelectorAll('.node-row-mobile').forEach(card => {
        const cardStatus = card.dataset.status;
        const cardGroups = card.dataset.groups || '';
        
        let show = true;
        if (status && cardStatus !== status) show = false;
        if (group && !cardGroups.includes(group)) show = false;
        
        card.style.display = show ? '' : 'none';
    });
    
    // Update counter
    document.getElementById('resultsCount').textContent = i18n.total + ': ' + visibleCount;
}

// Map status strings to sort order (online first, then error, then offline)
function statusSortOrder(s) {
    return s === 'online' ? 0 : s === 'error' ? 1 : 2;
}

function statusBadgeVariant(status) {
    return status === 'online' ? 'success' : (status === 'error' ? 'danger' : 'warning');
}

function sortNodesTable() {
    const key = document.getElementById('sortNodes').value;

    const comparators = {
        ranking: (a, b) => (parseFloat(a.dataset.ranking) || 1) - (parseFloat(b.dataset.ranking) || 1),
        name:    (a, b) => (a.dataset.name || '').localeCompare(b.dataset.name || ''),
        online:  (a, b) => (parseInt(b.dataset.online) || 0) - (parseInt(a.dataset.online) || 0),
        status:  (a, b) => statusSortOrder(a.dataset.status) - statusSortOrder(b.dataset.status),
    };
    const cmp = comparators[key] || comparators.ranking;

    // Sort desktop table rows using a DocumentFragment for a single reflow
    const tbody = document.querySelector('#nodesTable tbody');
    if (tbody) {
        const rows = Array.from(tbody.querySelectorAll('.node-row'));
        rows.sort(cmp);
        const frag = document.createDocumentFragment();
        rows.forEach(r => frag.appendChild(r));
        tbody.appendChild(frag);
    }

    // Mirror sort for mobile cards
    const mobileList = document.querySelector('.mobile-nodes-list');
    if (mobileList) {
        const cards = Array.from(mobileList.querySelectorAll('.node-row-mobile'));
        cards.sort(cmp);
        const frag = document.createDocumentFragment();
        cards.forEach(c => frag.appendChild(c));
        mobileList.appendChild(frag);
    }

    // Disable drag-and-drop when not sorting by priority — positions would conflict
    if (window._nodesSortable) {
        window._nodesSortable.option('disabled', key !== 'ranking');
        document.querySelectorAll('.drag-handle').forEach(h => {
            h.style.opacity = key === 'ranking' ? '' : '0.3';
            h.style.cursor = key === 'ranking' ? 'grab' : 'default';
        });
    }
}

function setNodeStatusUi(nodeId, status, nodeType) {
    if (!status) return;

    document.querySelectorAll(`[data-id="${nodeId}"]`).forEach(row => {
        row.dataset.status = status;
        if (nodeType) row.dataset.type = nodeType;
    });

    if (nodeType === 'virtual') return;

    document.querySelectorAll(`[data-node-status-badge][data-node-id="${nodeId}"]`).forEach(badge => {
        if (badge.dataset.nodeVirtualStatus === 'true') return;
        badge.className = `badge badge-${statusBadgeVariant(status)}`;
        badge.textContent = status;
    });
}

function setNodeActiveUi(nodeId, active, status, nodeType) {
    document.querySelectorAll(`[data-id="${nodeId}"]`).forEach(row => {
        row.dataset.active = String(active);
        if (nodeType) row.dataset.type = nodeType;
    });

    document.querySelectorAll(`[data-node-active-input][data-node-id="${nodeId}"]`).forEach(input => {
        input.checked = active;
        input.setAttribute('aria-label', `${active ? i18n.nodeDisableAria : i18n.nodeEnableAria}${input.dataset.nodeName ? ': ' + input.dataset.nodeName : ''}`);

        const label = input.closest('.toggle-switch');
        if (label) {
            label.title = active ? i18n.nodeDisableTitle : i18n.nodeEnableTitle;
        }
    });

    document.querySelectorAll(`[data-node-active-off-badge][data-node-id="${nodeId}"]`).forEach(badge => {
        badge.style.display = active ? 'none' : '';
    });

    setNodeStatusUi(nodeId, status, nodeType);
}

function setNodeActiveInputsDisabled(nodeId, disabled) {
    document.querySelectorAll(`[data-node-active-input][data-node-id="${nodeId}"]`).forEach(input => {
        input.disabled = disabled;
    });
}

async function toggleNodeActive(nodeId, active) {
    const previousActive = !active;
    let serverFailureApplied = false;

    setNodeActiveUi(nodeId, active);
    setNodeActiveInputsDisabled(nodeId, true);

    try {
        const res = await fetch(`/api/nodes/${nodeId}/${active ? 'enable' : 'disable'}`, {
            method: 'POST',
            credentials: 'include'
        });
        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
            if (data.node && typeof data.node.active === 'boolean') {
                setNodeActiveUi(nodeId, data.node.active, data.node.status, data.node.type);
                serverFailureApplied = true;
            }
            throw new Error(data.error || i18n.nodeActiveError);
        }

        const finalActive = data.node && typeof data.node.active === 'boolean' ? data.node.active : active;
        setNodeActiveUi(nodeId, finalActive, data.node && data.node.status, data.node && data.node.type);
        showToast(finalActive ? i18n.nodeEnabled : i18n.nodeDisabled);
    } catch (error) {
        if (!serverFailureApplied) {
            setNodeActiveUi(nodeId, previousActive);
        }
        showToast(error.message || i18n.nodeActiveError, 'error');
    } finally {
        setNodeActiveInputsDisabled(nodeId, false);
    }
}

async function restartNode(id) {
    const btn = event.target;
    const originalText = btn.textContent;
    btn.innerHTML = '<i class="ti ti-loader-2"></i>';
    btn.disabled = true;
    
    try {
        const res = await fetch(`/panel/nodes/${id}/restart`, {
            method: 'POST',
            credentials: 'include'
        });
        const data = await res.json();
        
        if (data.success) {
            showToast(i18n.restartSuccess);
            // Update status badge
            const row = btn.closest('tr') || btn.closest('.mobile-node-card');
            const badge = row.querySelector('.badge');
            if (badge) {
                badge.className = 'badge badge-success';
                badge.textContent = 'online';
            }
        } else {
            showToast(i18n.restartFailed + ': ' + (data.error || ''), 'error');
        }
    } catch (e) {
        showToast(i18n.restartFailed, 'error');
    }
    
    btn.textContent = originalText;
    btn.disabled = false;
}

async function deleteNode(id) {
    if (!confirm(i18n.confirmDelete)) return;
    
    const res = await fetch(`/api/nodes/${id}`, {
        method: 'DELETE',
        credentials: 'include'
    });
    
    if (res.ok) {
        location.reload();
    } else {
        const data = await res.json().catch(() => ({}));
        showToast(data.error || i18n.deleteError, 'error');
    }
}


// ==================== View Tabs ====================

// Auto-restore network tab if navigated from node-form (set by node-form.ejs)
const _requestedNodesView = new URLSearchParams(window.location.search).get('view');
const _restoreNetworkView = _requestedNodesView === 'network' || sessionStorage.getItem('nodesView') === 'network';
if (_restoreNetworkView) sessionStorage.removeItem('nodesView');

let networkLoaded = false;

function switchNodesView(view) {
    const viewList = document.getElementById('viewList');
    const viewNetwork = document.getElementById('viewNetwork');
    const tabList = document.getElementById('tabList');
    const tabNetwork = document.getElementById('tabNetwork');
    const listFilters = document.getElementById('listFilters');
    const networkToolbar = document.getElementById('networkToolbar');
    const listActions = document.getElementById('listActions');
    const networkActions = document.getElementById('networkActions');

    if (view === 'network') {
        viewList.style.display = 'none';
        viewNetwork.style.display = '';
        tabList.classList.remove('active');
        tabNetwork.classList.add('active');
        listFilters.style.display = 'none';
        networkToolbar.style.display = '';
        listActions.style.display = 'none';
        networkActions.style.display = '';

        if (!networkLoaded) {
            loadNetworkScripts();
            networkLoaded = true;
        } else if (window._networkResize) {
            // Small delay to let the display:'' take effect before resize
            setTimeout(window._networkResize, 50);
        }
    } else {
        viewList.style.display = '';
        viewNetwork.style.display = 'none';
        tabList.classList.add('active');
        tabNetwork.classList.remove('active');
        listFilters.style.display = '';
        networkToolbar.style.display = 'none';
        listActions.style.display = '';
        networkActions.style.display = 'none';
    }
}

