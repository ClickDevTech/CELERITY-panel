<div class="page-header">
    <!-- Заголовок уже в topbar; здесь только подсказка -->
    <p class="hint"><%= t('groups.pageHint') %></p>
</div>

<div class="card">
    <div class="card-header">
        <h2><i class="ti ti-folder-plus"></i> <%= t('groups.addGroup') %></h2>
    </div>
    <div class="card-body">
        <form method="POST" action="/panel/groups" class="form-inline">
            <div class="form-row">
                <div class="form-group" style="flex: 2;">
                    <label class="form-label" for="group-name"><%= t('groups.groupName') %></label>
                    <input type="text" id="group-name" name="name" placeholder="<%= t('groups.groupNamePlaceholder') %>" required>
                </div>
                <div class="form-group" style="flex: 2;">
                    <label class="form-label" for="group-subtitle"><%= t('groups.subscriptionTitle') %></label>
                    <input type="text" id="group-subtitle" name="subscriptionTitle" placeholder="<%= t('groups.subscriptionTitlePlaceholder') %>" title="<%= t('groups.subscriptionTitleHint') %>">
                </div>
                <div class="form-group" style="flex: 1;">
                    <label class="form-label" for="group-devices"><%= t('groups.maxDevices') %></label>
                    <input type="number" id="group-devices" name="maxDevices" placeholder="<%= t('groups.maxDevicesPlaceholder') %>" min="0" value="0" title="<%= t('groups.maxDevicesHint') %>">
                </div>
                <div class="form-group" style="flex: 0.8;">
                    <label class="form-label"><%= t('groups.color') %></label>
                    <label class="color-swatch" title="<%= t('groups.colorHint') %>">
                        <input type="color" name="color" value="#f4f4f5" data-swatch>
                        <span class="swatch-dot" style="background:#f4f4f5"></span>
                        <code class="swatch-hex">#f4f4f5</code>
                    </label>
                </div>
                <button type="submit" class="btn btn-primary"><i class="ti ti-plus"></i> <%= t('groups.createGroup') %></button>
            </div>
            <small class="hint"><%= t('groups.formHint') %></small>
        </form>
    </div>
</div>

<div class="card mt-2">
    <div class="card-header">
        <h2><i class="ti ti-folders"></i> <%= t('groups.allGroups') %> (<%= groups.length %>)</h2>
    </div>
    <div class="card-body">
        <% if (groups.length === 0) { %>
            <div class="empty-state">
                <svg class="empty-ornament" width="120" height="72" viewBox="0 0 120 72" aria-hidden="true" focusable="false">
                    <g fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.5">
                        <path d="M60 6 L74 6 L74 20 Q60 26 46 20 L46 6 Z" />
                        <path d="M60 6 L60 20" /><path d="M46 13 L74 13" />
                        <path d="M22 52 Q22 34 40 30" /><path d="M98 52 Q98 34 80 30" />
                        <path d="M40 52 L40 30" /><path d="M80 52 L80 30" />
                        <path d="M40 36 Q60 42 80 36" /><path d="M40 44 Q60 50 80 44" />
                        <circle cx="60" cy="52" r="3" />
                        <path d="M36 58 Q60 66 84 58" />
                    </g>
                </svg>
                <p><%= t('groups.noGroups') %></p>
                <p class="hint"><%= t('groups.noGroupsHint') %></p>
            </div>
        <% } else { %>
            <div class="groups-grid">
                <% groups.forEach(group => { %>
                    <div class="group-card" style="border-left: 4px solid <%= group.color %>">
                        <form method="POST" action="/panel/groups/<%= group._id %>">

                            <div class="group-header">
                                <input type="text" name="name" value="<%= group.name %>" class="group-name-input" aria-label="<%= t('groups.groupName') %>" required>
                                <label class="color-swatch" title="<%= t('groups.colorHint') %>">
                                    <input type="color" name="color" value="<%= group.color %>" data-swatch>
                                    <span class="swatch-dot" style="background:<%= group.color %>"></span>
                                    <code class="swatch-hex"><%= group.color %></code>
                                </label>
                            </div>

                            <div class="group-stats">
                                <span class="stat"><i class="ti ti-server"></i> <%= group.nodesCount || 0 %> <%= pluralize(group.nodesCount || 0, ['нода', 'ноды', 'нод']) %></span>
                                <span class="stat"><i class="ti ti-users"></i> <%= group.usersCount || 0 %> <%= pluralize(group.usersCount || 0, ['пользователь', 'пользователя', 'пользователей']) %></span>
                                <span class="stat" title="<%= t('groups.maxDevices') %>"><i class="ti ti-device-mobile"></i> <%= group.maxDevices || '∞' %></span>
                            </div>

                            <div class="form-row-inline">
                                <input type="text" name="subscriptionTitle" value="<%= group.subscriptionTitle || '' %>" placeholder="<%= t('groups.subscriptionTitlePlaceholder') %>" class="group-description" style="flex: 2;" title="<%= t('groups.subscriptionTitleHint') %>" aria-label="<%= t('groups.subscriptionTitle') %>">
                                <input type="number" name="maxDevices" value="<%= group.maxDevices || 0 %>" min="0" placeholder="<%= t('groups.maxDevices') %>" class="group-devices" style="flex: 1;" title="<%= t('groups.maxDevicesHint') %>" aria-label="<%= t('groups.maxDevices') %>">
                            </div>
                            
                            <div class="group-actions">
                                <label class="checkbox-label">
                                    <input type="checkbox" name="active" <%= group.active !== false ? 'checked' : '' %>>
                                    <span><%= t('groups.isActive') %></span>
                                </label>
                                <div class="btn-group">
                                    <button type="submit" class="btn btn-sm btn-primary"><i class="ti ti-device-floppy"></i> <%= t('groups.save') %></button>
                                </div>
                            </div>
                        </form>
                        
                        <form method="POST" action="/panel/groups/<%= group._id %>/delete" class="delete-form" onsubmit="return confirm('<%= t('groups.confirmDelete').replace('{name}', group.name) %>')">
                            <button type="submit" class="btn btn-sm btn-danger"><i class="ti ti-trash"></i></button>
                        </form>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</div>

<style>
.form-inline .form-row {
    display: flex;
    gap: 0.75rem;
    align-items: flex-end;
    flex-wrap: wrap;
}
.form-inline .form-group {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
}
/* Live hex + dot update for the swatch: see the listener below */
</style>
<script>
document.addEventListener('change', function (e) {
    const input = e.target;
    if (!input.matches || !input.matches('input[type="color"][data-swatch]')) return;
    const swatch = input.closest('.color-swatch');
    if (!swatch) return;
    const dot = swatch.querySelector('.swatch-dot');
    const hex = swatch.querySelector('.swatch-hex');
    if (dot) dot.style.background = input.value;
    if (hex) hex.textContent = input.value;
});
</script>

<style>
/* (real styles follow) */

.form-inline .form-group {
    margin: 0;
}
.form-inline input[type="color"] {
    width: 48px;
    height: 38px;
    padding: 2px;
    border-radius: var(--radius-xs);
    cursor: pointer;
}
/* Round color swatch + hex readout (native <input type=color> скрыт поверх) */
.form-group > label.color-swatch,
label.color-swatch {
    position: relative;
    display: inline-flex !important;
    align-items: center;
    gap: 8px;
    margin-bottom: 0;
    cursor: pointer;
    min-height: 34px;
}
.swatch-dot { display: inline-block; }
.color-swatch input[type="color"] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 1;
}
.swatch-dot {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 1px solid var(--border-light);
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.35), 0 0 0 3px rgba(255, 255, 255, 0.03);
    transition: box-shadow 0.15s ease;
}
.color-swatch:hover .swatch-dot { box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.35), 0 0 0 3px rgba(255, 255, 255, 0.09); }
.swatch-hex {
    font-family: "SF Pro Mono", "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    color: var(--text-muted);
    text-transform: none;
}
.empty-ornament { display: block; margin: 0 auto 14px; color: var(--text-muted); }
@media (max-width: 768px) {
    .form-inline .form-row {
        flex-direction: column;
        align-items: stretch;
    }
    .form-inline .form-group {
        flex: 1 1 100% !important;
    }
    .form-inline .form-row > .btn {
        width: 100%;
    }
    .form-row-inline {
        flex-direction: column;
    }
    .group-devices {
        width: 100% !important;
    }
    .groups-grid {
        grid-template-columns: 1fr;
    }
}
.groups-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
}
.group-card {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    padding: 1rem;
    position: relative;
    backdrop-filter: var(--glass-blur-sm);
    -webkit-backdrop-filter: var(--glass-blur-sm);
    box-shadow: var(--glass-shadow);
}
.group-header {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
}
.group-name-input {
    flex: 1;
    font-weight: 600;
    font-size: 1.1rem;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.25rem 0;
}
.group-name-input:focus {
    outline: none;
    border-color: var(--accent);
}
.color-picker {
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    border-radius: var(--radius-xs);
    cursor: pointer;
}
.group-stats {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-muted);
}
.form-row-inline {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
}
.group-description, .group-devices {
    padding: 0.5rem;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.9rem;
}
.group-description:focus, .group-devices:focus {
    outline: none;
    border-color: var(--accent);
    background: rgba(255, 255, 255, 0.06);
}
.group-devices {
    width: 80px;
    text-align: center;
}
.group-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.delete-form {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
}
.delete-form .btn {
    padding: 0.25rem 0.5rem;
    font-size: 0.8rem;
}
.empty-state {
    text-align: center;
    padding: 2rem;
    color: var(--text-muted);
}
</style>
